    "react-dom": "^19.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
