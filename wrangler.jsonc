{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astra-marketing-template",
  "main": "cloud/entry.ts",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ASTRA_LOOP",
        "class_name": "AstraLoop"
      }
    ]
  },
  "migrations": [
    {
      "tag": "astra-loop-v1",
      "new_sqlite_classes": [
        "AstraLoop"
      ]
    }
  ],
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astra-marketing-template",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
