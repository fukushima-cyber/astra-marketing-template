{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astra-marketing-template",
  "main": "cloud/entry.ts",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ASTRA_LOOP",
        "class_name": "AstraLoop"
      }
    ]
  },
  "migrations": [
    {
      "tag": "astra-loop-v1",
      "new_sqlite_classes": [
        "AstraLoop"
      ]
    }
  ],
  "preview_urls": false,
  "hyperdrive": [
    {
      "binding": "SUPABASE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "DB_PROVIDER": "supabase",
    "ASTRA_MAINTENANCE": "0",
    "ASTRA_MIGRATION_ENABLED": "0"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
